{%- comment -%}
  Vídeo flutuante (estilo stories) com os vídeos do metafield custom.video.
  - Canto inferior esquerdo, acima do botão "10% OFF" (Shopify Forms).
  - Miniatura 9:16 tocando sem som; ao clicar expande no próprio lugar, com som,
    barras de progresso e toque nas laterais para voltar/avançar.
  - "x" fecha o widget até o fim da sessão.
  Ajuste a distância do rodapé em --sv-bottom (mobile) / --sv-bottom-desktop.
{%- endcomment -%}
{%- assign videos = product.metafields.custom.video.value -%}

{%- if videos != blank -%}
<style>
  .sv-float {
    --sv-bottom: 120px;
    --sv-bottom-desktop: 93px;
    position: fixed;
    left: 16px;
    bottom: calc(var(--sv-bottom) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    width: 96px;
    aspect-ratio: 9 / 16;
    transition: width 0.4s ease;
  }

  .sv-float[hidden] { display: none; }

  .sv-float.is-expanded { width: min(280px, calc(100vw - 32px)); }

  @media (min-width: 768px) {
    .sv-float {
      left: 24px;
      bottom: var(--sv-bottom-desktop);
      width: 120px;
    }
    .sv-float.is-expanded { width: 300px; }
  }

  /* Expandido: garante que caiba na altura da tela */
  .sv-float.is-expanded {
    max-width: calc((100vh - var(--sv-bottom) - 32px) * 9 / 16);
  }

  .sv-float__frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }

  .sv-float__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sv-float__media.is-active { opacity: 1; }

  .sv-float__bars {
    position: absolute;
    top: 6px;
    left: 6px;
    right: 6px;
    z-index: 2;
    display: flex;
    gap: 3px;
    pointer-events: none;
  }

  .sv-float.is-expanded .sv-float__bars { top: 10px; left: 10px; right: 10px; }

  .sv-float__bar {
    flex: 1 1 0%;
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.4);
  }

  .sv-float__bar span {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(var(--progress, 0));
    transform-origin: left center;
  }

  .sv-float__nav {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    display: none;
    width: 30%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .sv-float__nav--prev { left: 0; }
  .sv-float__nav--next { right: 0; }
  .sv-float.is-expanded .sv-float__nav { display: block; }

  .sv-float__close {
    position: absolute;
    top: -8px;
    right: -8px;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: rgb(var(--color-foreground, 0 0 0));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    cursor: pointer;
  }

  .sv-float__close svg { width: 12px; height: 12px; }
</style>

<div class="sv-float{% if videos.size > 1 %} sv-float--multi{% endif %}" id="SvFloat-{{ product.id }}" hidden>
  <button type="button" class="sv-float__frame" aria-label="Assistir vídeo de {{ product.title | escape }}">
    {%- if videos.size > 1 -%}
      <span class="sv-float__bars" aria-hidden="true">
        {%- for video in videos -%}
          <span class="sv-float__bar"><span></span></span>
        {%- endfor -%}
      </span>
    {%- endif -%}

    {%- for video in videos -%}
      {%- liquid
        assign src = video.sources[1].url | default: video.sources[0].url
      -%}
      <video
        class="sv-float__media{% if forloop.first %} is-active{% endif %}"
        data-src="{{ src }}"
        {%- if video.preview_image %} poster="{{ video.preview_image | image_url: width: 400 }}"{% endif %}
        muted
        playsinline
        preload="none"
      ></video>
    {%- endfor -%}
  </button>

  <button type="button" class="sv-float__nav sv-float__nav--prev" aria-label="Vídeo anterior"></button>
  <button type="button" class="sv-float__nav sv-float__nav--next" aria-label="Próximo vídeo"></button>

  <button type="button" class="sv-float__close" aria-label="Fechar vídeo">
    <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <path d="M2 2l8 8M10 2l-8 8"/>
    </svg>
  </button>
</div>

<script>
  (function() {
    var root = document.getElementById('SvFloat-{{ product.id }}');
    if (!root) return;

    var STORAGE_KEY = 'sv-float-closed';
    try {
      if (sessionStorage.getItem(STORAGE_KEY)) return;
    } catch (e) {}

    // Fica fixo na viewport: move para o <body> para não ser afetado por transform de ancestrais
    document.body.appendChild(root);
    root.hidden = false;

    var frame = root.querySelector('.sv-float__frame');
    var videos = Array.prototype.slice.call(root.querySelectorAll('.sv-float__media'));
    var bars = Array.prototype.slice.call(root.querySelectorAll('.sv-float__bar span'));
    var current = 0;
    var expanded = false;
    var rafId = null;

    function load(v) {
      if (!v.getAttribute('src') && v.dataset.src) v.src = v.dataset.src;
    }

    function setBars() {
      bars.forEach(function(bar, i) {
        bar.style.setProperty('--progress', i < current ? 1 : 0);
      });
    }

    function tick() {
      var v = videos[current];
      if (bars[current] && v.duration) {
        bars[current].style.setProperty('--progress', Math.min(v.currentTime / v.duration, 1));
      }
      rafId = requestAnimationFrame(tick);
    }

    function show(index, restart) {
      if (index < 0 || index >= videos.length) return;
      videos.forEach(function(v, i) {
        if (i !== index) {
          v.pause();
          v.classList.remove('is-active');
        }
      });
      current = index;
      var v = videos[current];
      load(v);
      v.classList.add('is-active');
      v.muted = !expanded;
      // Na miniatura fica em loop; expandido passa para o próximo ao terminar
      v.loop = !expanded || videos.length === 1;
      if (restart) v.currentTime = 0;
      setBars();
      var p = v.play();
      if (p && p.catch) {
        p.catch(function() {
          // Navegador bloqueou som: toca sem som
          v.muted = true;
          v.play().catch(function() {});
        });
      }
    }

    function expand() {
      expanded = true;
      root.classList.add('is-expanded');
      show(current, true);
    }

    function collapse() {
      expanded = false;
      root.classList.remove('is-expanded');
      show(current, false);
    }

    videos.forEach(function(v, i) {
      v.addEventListener('ended', function() {
        if (!expanded || i !== current) return;
        if (current < videos.length - 1) show(current + 1, true);
        else collapse();
      });
    });

    frame.addEventListener('click', function() {
      if (expanded) collapse();
      else expand();
    });

    root.querySelector('.sv-float__nav--prev').addEventListener('click', function(e) {
      e.stopPropagation();
      show(current > 0 ? current - 1 : 0, true);
    });

    root.querySelector('.sv-float__nav--next').addEventListener('click', function(e) {
      e.stopPropagation();
      if (current < videos.length - 1) show(current + 1, true);
      else collapse();
    });

    root.querySelector('.sv-float__close').addEventListener('click', function(e) {
      e.stopPropagation();
      videos.forEach(function(v) { v.pause(); });
      cancelAnimationFrame(rafId);
      root.hidden = true;
      try { sessionStorage.setItem(STORAGE_KEY, '1'); } catch (err) {}
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && expanded) collapse();
    });

    // Troca o vídeo conforme a cor selecionada (mesma ordem das cores)
    function swatchIndex() {
      var radios = document.querySelectorAll('.product-form__input_color input[type="radio"]');
      for (var i = 0; i < radios.length; i++) {
        if (radios[i].checked) return i;
      }
      return -1;
    }

    document.addEventListener('change', function(e) {
      if (!e.target.matches || !e.target.matches('.product-form__input_color input[type="radio"]')) return;
      var idx = swatchIndex();
      if (idx >= 0 && idx < videos.length && idx !== current) show(idx, true);
    });

    var start = swatchIndex();
    show(start > 0 && start < videos.length ? start : 0, false);
    tick();
  })();
</script>
{%- endif -%}

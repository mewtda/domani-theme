{%- comment -%}
  Renders a simple product add-on option with circular image
  Usage:
  {% render 'product-addon-option', addon_product: all_products['seu-produto-addon'] %}
{%- endcomment -%}

<div class="product-addon-option flex items-center gap-3">
  <div class="w-8 h-8 rounded-full overflow-hidden">
    {{ addon_product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover' }}
  </div>
  <label class="flex items-center gap-2 cursor-pointer">
    <input type="checkbox" name="properties[{{ addon_product.title }}]" value="{{ addon_product.id }}" class="sr-only peer">
    <div class="relative flex items-center">
      <span class="peer-checked:hidden">Adicionar (+{{ addon_product.price | money }})</span>
      <span class="hidden peer-checked:block">Adicionado</span>
    </div>
  </label>
</div>